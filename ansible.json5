{
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^ansible/group_vars/.*\\.yml/",
        "/^vars/main\\.yml/"
      ],
      "matchStrings": [
        "repoName:\\s+(?<depName>.*)\\s+tag:\\s+(?<currentValue>.*)"
      ],
      "datasourceTemplate": "github-releases"
    }
  ]
}
