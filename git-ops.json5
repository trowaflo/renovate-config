{
  "platformAutomerge": false,
  "kubernetes": {
    // Raw manifests live under kustomize/resources/ and infra/.../resources/,
    // whatever their file name (statefulset, daemonset, cronjob...).
    "managerFilePatterns": [
      "/deployment\\.ya?ml$/",
      "/(^|/)kustomize/resources/.+\\.ya?ml$/",
      "/^infra/.+/resources/.+\\.ya?ml$/"
    ]
  },
  "customManagers": [
    // Helm chart on OCI registry. `(?:#[^\n]*\n\s*)*` skips comment lines
    // between keys (frigate keeps its upstream repoURL commented out).
    {
      "customType": "regex",
      "managerFilePatterns": ["/(^|.*/)(description\\.yaml)$/"],
      "matchStrings": ["ccm:\\s+(?:#[^\\n]*\\n\\s*)*repoURL:\\s+(?<registryDomain>[^\\s]+)\/+(?<namespace>[^\\s]+)\\s+(?:#[^\\n]*\\n\\s*)*targetRevision:\\s+(?<currentValue>[^\\s]+)\\s+(?:#[^\\n]*\\n\\s*)*chart:\\s+(?<chart>[^\\s]+)\\s+(?:#[^\\n]*\\n\\s*)*type:\\s+oci"],
      "datasourceTemplate": "docker",
      "depNameTemplate": "{{namespace}}/{{chart}}",
      "registryUrlTemplate": "https://{{registryDomain}}"
    },
    // Helm chart on Helm repo
    {
      "customType": "regex",
      "managerFilePatterns": ["/(^|.*/)(description\\.yaml)$/"],
      "matchStrings": ["ccm:\\s+(?:#[^\\n]*\\n\\s*)*repoURL:\\s+(?<registryUrl>[^\\s]+)\\s+(?:#[^\\n]*\\n\\s*)*targetRevision:\\s+(?<currentValue>[^\\s]+)\\s+(?:#[^\\n]*\\n\\s*)*chart:\\s+(?<depName>[^\\s]+)\\s+(?:#[^\\n]*\\n\\s*)*type:\\s+helm"],
      "datasourceTemplate": "helm"
    },
    // In-house charts referenced from an ApplicationSet global-values.yaml
    // (kgatewayRoutingChart, persistentVolumeChart): repoURL, chart, targetRevision.
    {
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)global-values\\.ya?ml$/"],
      "matchStrings": ["repoURL:\\s+(?<registryUrl>https?://[^\\s]+)\\s+(?:#[^\\n]*\\n\\s*)*chart:\\s+(?<depName>[^\\s]+)\\s+(?:#[^\\n]*\\n\\s*)*targetRevision:\\s+(?<currentValue>[^\\s]+)"],
      "datasourceTemplate": "helm"
    }
  ]
}
