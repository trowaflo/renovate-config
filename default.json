{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    "mergeConfidence:all-badges",
    "helpers:pinGitHubActionDigestsToSemver",
    "github>trowaflo/renovate-config:ansible.json5",
    "github>trowaflo/renovate-config:ci.json5",
    "github>trowaflo/renovate-config:docker.json5",
    "github>trowaflo/renovate-config:git-ops.json5",
    "github>trowaflo/renovate-config:helm.json5",
    "github>trowaflo/renovate-config:kubernetes.json5",
    "github>trowaflo/renovate-config:no_category.json5"
  ],
  "reviewers": ["trowaflo"],
  "minimumReleaseAge": "30 days",
  "minimumReleaseAgeBehaviour": "timestamp-required",
  "internalChecksFilter": "strict",
  "commitBodyTable": true,
  "commitMessageExtra": "{{#unless isGroup}}({{{depName}}} {{{newVersion}}}){{/unless}}",
  "prTitleStrict": true,
  "pinDigests": true,
  "rangeStrategy": "pin",
  "packageRules": [
    {
      "matchUpdateTypes": ["major"],
      "addLabels": ["breaking"]
    },
    {
      "description": "Terraform CLI version stays a range: an exact pin forces every machine onto one patch release. Providers stay pinned by the lock file.",
      "matchManagers": ["terraform"],
      "matchDepTypes": ["required_version"],
      "rangeStrategy": "replace"
    },
    {
      "matchManagers": ["github-actions"],
      "pinDigests": true
    },
    {
      "matchManagers": ["dockerfile", "docker-compose"],
      "pinDigests": true
    },
    {
      "matchManagers": ["helm-values", "helmv3"],
      "pinDigests": true
    }
  ],
  "timezone": "Europe/Paris",
  "schedule": [
    "before 5am on the first day of the month"
  ]
}
