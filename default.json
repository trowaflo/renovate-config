{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "mergeConfidence:all-badges",
    "helpers:pinGitHubActionDigestsToSemver",
    "github>trowaflo/renovate-config:ansible.json5",
    "github>trowaflo/renovate-config:ci.json5",
    "github>trowaflo/renovate-config:docker.json5",
    "github>trowaflo/renovate-config:git-ops.json5",
    "github>trowaflo/renovate-config:helm.json5",
    "github>trowaflo/renovate-config:kubernetes.json5",
    "github>trowaflo/renovate-config:no_category.json5"
  ],
  "reviewers": ["trowaflo"],
  "minimumReleaseAge": "30 days",
  "minimumReleaseAgeBehaviour": "timestamp-optional",
  "internalChecksFilter": "strict",
  "commitBodyTable": true,
  "commitMessageExtra": "{{#unless isGroup}}({{{depName}}} {{{newVersion}}}){{/unless}}",
  "prTitleStrict": true,
  "pinDigests": true,
  "rangeStrategy": "pin",
  "packageRules": [
    {
      "matchUpdateTypes": ["major"],
      "addLabels": ["breaking"]
    },
    {
      "description": "Terraform CLI version stays a range: an exact pin forces every machine onto one patch release. Providers stay pinned by the lock file.",
      "matchManagers": ["terraform"],
      "matchDepTypes": ["required_version"],
      "rangeStrategy": "replace"
    },
    {
      "description": "In-house actions, presets and charts: no waiting period, the author is the reviewer.",
      "matchPackageNames": ["trowaflo/**"],
      "minimumReleaseAge": "0 days"
    },
    {
      "description": "In-house Helm charts, published at trowaflo.github.io.",
      "matchRegistryUrls": ["https://trowaflo.github.io/**"],
      "minimumReleaseAge": "0 days"
    },
    {
      "description": "helm-values only knows the tag field and appends the digest to it; charts that reuse the tag as a semver (kube-prometheus-stack) break silently. A repo opts in with its own rule.",
      "matchManagers": ["helm-values"],
      "pinDigests": false
    }
  ],
  "timezone": "Europe/Paris",
  "schedule": [
    "before 5am on monday"
  ]
}
